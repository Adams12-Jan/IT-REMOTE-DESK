{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Vetiva corporate user account linked to Firebase Authentication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified corporate email address",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Full display name",
          "minLength": 1,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "description": "Corporate department",
          "minLength": 1,
          "maxLength": 100
        },
        "roleSlug": {
          "type": "string",
          "enum": ["admin", "technician", "employee"],
          "description": "Role-based access control tier"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether account is enabled"
        },
        "isOnline": {
          "type": "boolean",
          "description": "Live presence state"
        },
        "inviteId": {
          "type": "string",
          "description": "Optional invite ID used when claiming a pre-assigned role",
          "maxLength": 128
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last seen timestamp"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "department",
        "roleSlug",
        "isActive",
        "isOnline",
        "lastSeenAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Admin-issued corporate invitation pre-assigning role and department.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "roleSlug": {
          "type": "string",
          "enum": ["admin", "technician", "employee"]
        },
        "claimed": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "email",
        "displayName",
        "department",
        "roleSlug",
        "claimed",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "TechnicianPresence": {
      "title": "TechnicianPresence",
      "description": "Non-PII IT support technician availability card for the operations dashboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "roleSlug": {
          "type": "string",
          "enum": ["admin", "technician"]
        },
        "isActive": {
          "type": "boolean"
        },
        "isOnline": {
          "type": "boolean"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "department",
        "roleSlug",
        "isActive",
        "isOnline",
        "lastSeenAt",
        "updatedAt"
      ]
    },
    "DeviceRecord": {
      "title": "DeviceRecord",
      "description": "Registered Vetiva workstation device belonging to a user.",
      "type": "object",
      "properties": {
        "deviceCode": {
          "type": "string",
          "pattern": "^\\d{9,12}$",
          "maxLength": 12
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "osPlatform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "agentVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "nativeAgentLinked": {
          "type": "boolean"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "deviceCode",
        "ownerUid",
        "hostname",
        "osPlatform",
        "agentVersion",
        "nativeAgentLinked",
        "lastActiveAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global corporate security policy configuration.",
      "type": "object",
      "properties": {
        "settingKey": {
          "type": "string",
          "enum": ["default"]
        },
        "sessionExpiryMinutes": {
          "type": "integer"
        },
        "maxFailedAttempts": {
          "type": "integer"
        },
        "maxFileSizeMb": {
          "type": "integer"
        },
        "requireExplicitControlConsent": {
          "type": "boolean"
        },
        "allowSessionRecording": {
          "type": "boolean"
        },
        "enforceVetivaDomainOnly": {
          "type": "boolean"
        },
        "allowedFileExtensions": {
          "type": "array",
          "description": "Allowed file extensions list (max 25 items)"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "settingKey",
        "sessionExpiryMinutes",
        "maxFailedAttempts",
        "maxFileSizeMb",
        "requireExplicitControlConsent",
        "allowSessionRecording",
        "enforceVetivaDomainOnly",
        "allowedFileExtensions",
        "updatedAt"
      ]
    },
    "RemoteSession": {
      "title": "RemoteSession",
      "description": "Remote desktop support session with explicit host approval and granular permissions.",
      "type": "object",
      "properties": {
        "sessionCode": {
          "type": "string",
          "pattern": "^\\d{9,12}$",
          "maxLength": 12
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostSummary": {
          "type": "object"
        },
        "technicianUid": {
          "type": "string",
          "maxLength": 128
        },
        "technicianSummary": {
          "type": "object"
        },
        "deviceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "pending_approval", "active", "rejected", "ended", "expired"]
        },
        "issueSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tokenHash": {
          "type": "string",
          "maxLength": 128
        },
        "connectionQuality": {
          "type": "string",
          "enum": ["excellent", "good", "fair", "poor"]
        },
        "latencyMs": {
          "type": "integer"
        },
        "permissions": {
          "type": "object"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "endReason": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionCode",
        "hostUid",
        "hostSummary",
        "deviceId",
        "status",
        "issueSummary",
        "connectionQuality",
        "latencyMs",
        "permissions",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SessionAccessToken": {
      "title": "SessionAccessToken",
      "description": "Single-use SHA-256 access code verifier document keyed by its hash.",
      "type": "object",
      "properties": {
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["hostUid", "createdAt"]
    },
    "SessionMessage": {
      "title": "SessionMessage",
      "description": "Support chat or security event message within a session.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "technicianUid": {
          "type": "string",
          "maxLength": 128
        },
        "senderUid": {
          "type": "string",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "messageType": {
          "type": "string",
          "enum": ["text", "system"]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionId",
        "hostUid",
        "senderUid",
        "senderName",
        "messageType",
        "body",
        "createdAt"
      ]
    },
    "FileTransfer": {
      "title": "FileTransfer",
      "description": "Malware-scanned file transfer record authorized within a remote session.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "technicianUid": {
          "type": "string",
          "maxLength": 128
        },
        "uploaderUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "originalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "storedName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sizeBytes": {
          "type": "integer"
        },
        "sha256Hash": {
          "type": "string",
          "maxLength": 64
        },
        "scanStatus": {
          "type": "string",
          "enum": ["clean", "blocked"]
        },
        "downloadCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionId",
        "hostUid",
        "uploaderUid",
        "originalName",
        "storedName",
        "mimeType",
        "sizeBytes",
        "sha256Hash",
        "scanStatus",
        "downloadCount",
        "createdAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only security and compliance audit trail entry.",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 200
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        },
        "metadata": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "action", "severity", "metadata", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Corporate user profiles keyed by Firebase Auth UID."
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/UserInvite" },
      "description": "Admin-created user invitations with pre-assigned role and department."
    },
    "/technicians/{userId}": {
      "schema": { "$ref": "#/entities/TechnicianPresence" },
      "description": "Technician online availability cards without sensitive PII."
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceRecord" },
      "description": "Registered Vetiva workstations keyed by <uid>_primary."
    },
    "/appSettings/{settingKey}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global application security settings (singleton key 'default')."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/RemoteSession" },
      "description": "Remote desktop sessions keyed by 9-12 digit sessionCode."
    },
    "/sessions/{sessionId}/accessTokens/{tokenHash}": {
      "schema": { "$ref": "#/entities/SessionAccessToken" },
      "description": "Single-use SHA-256 token hash documents for atomic join verification."
    },
    "/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/SessionMessage" },
      "description": "Real-time support chat and system event log for a session."
    },
    "/sessions/{sessionId}/files/{fileId}": {
      "schema": { "$ref": "#/entities/FileTransfer" },
      "description": "Malware-scanned file transfer metadata within a session."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable corporate security audit trail."
    }
  }
}
