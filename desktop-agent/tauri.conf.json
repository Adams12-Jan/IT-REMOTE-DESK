{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vetiva IT Remote Desk Agent",
  "version": "1.0.0",
  "identifier": "com.vetiva.remotedesk.agent",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vetiva IT Remote Desk",
        "width": 1180,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss:"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "VETIVA_ED25519_PUBLIC_KEY_PLACEHOLDER",
      "endpoints": [
        "https://updates.vetiva.internal/remote-desk/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
