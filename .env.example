# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WebRTC TURN (Coturn) configuration (optional; defaults to public STUN if omitted)
TURN_SERVER_URL=
TURN_SHARED_SECRET=

# Local SQLite persistence path (optional; defaults to data/remote-desk.db)
SQLITE_DB_PATH=data/remote-desk.db
